# The network the receivable token is issued and settled on.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# ECDSA private key of the funded operator account.
# Real values live in .env, which is never tracked.
HEDERA_OPERATOR_KEY=

# The ATS deployment this package issues tokens against.
# Defaults, if unset, to the deployment the ATS web app itself points at on
# Hedera testnet — verified live via the mirror node.
# Factory  0.0.9213391
ATS_FACTORY_ID=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
# Resolver 0.0.9212226
ATS_RESOLVER_ID=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a
