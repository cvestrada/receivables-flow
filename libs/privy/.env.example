# Privy app the two accounts live in.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The approving group of three people, created by hand in the Privy dashboard.
# Two of the three must approve before Ironline Freight's account does anything.
PRIVY_APPROVING_GROUP_ID=

# Authorization key this package signs its API requests with.
PRIVY_AUTHORIZATION_KEY=

# The network both accounts sign for. Hedera testnet is EVM-compatible.
HEDERA_CAIP2=eip155:296

# Topping the accounts up: send HBAR from the operator account funded in TECH-560
# to the two addresses in accounts.json. The Hedera portal faucet refills that
# operator account with 1000 HBAR a day, which is far more than the demo needs.

# The three directors as Privy knows them, comma separated. Each signs in once at
# the business portal; their user id is on the Users page of the Privy dashboard.
PRIVY_DIRECTOR_USER_IDS=

# The authorization key that owns Woodgrove Capital's account. The id registers the
# key with Privy; the private key signs the fund's allocations and never leaves the
# server.
PRIVY_AUTHORIZATION_KEY_ID=

# Where the portals read the opened accounts from. Only needed when running from a
# directory outside the repo — otherwise libs/privy/accounts.json is found on its own.
PRIVY_ACCOUNTS_PATH=

# Reading balances. Any Hedera testnet JSON-RPC endpoint.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Only for running libs/privy/test/refusals.test.ts against the company account:
# access tokens for two signed-in directors, comma separated. Without them that half
# of the suite stands down and the refusal is checked by hand in the portal instead.
PRIVY_DIRECTOR_ACCESS_TOKENS=
