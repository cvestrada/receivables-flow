# Every credential libs/privy needs. Copy to libs/privy/.env and fill in.
# Nothing here reaches a browser — the portals read the opened accounts from
# accounts.json, which holds addresses and identifiers and no secret.

# ── The Privy app both accounts live in ──────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Ironline Freight's company account ───────────────────────────────────────
# The three directors' email addresses, comma separated. Provisioning creates them
# if they do not exist and builds the two-of-three approving group over exactly
# these three — nobody has to sign in first or copy an id off the dashboard. Each
# director then signs in at the business portal with the address named here.
PRIVY_DIRECTOR_EMAILS=anna@ironline.test,tom@ironline.test,grace@ironline.test

# ── Woodgrove Capital's fund account ─────────────────────────────────────────
# The authorization key that owns it. The id registers the key with Privy; the
# private key signs the fund's allocations and never leaves the server.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_KEY=

# ── The chain ────────────────────────────────────────────────────────────────
# The network both accounts sign for. Hedera testnet is EVM-compatible.
HEDERA_CAIP2=eip155:296

# Reading balances. Any Hedera testnet JSON-RPC endpoint.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Topping the accounts up: send HBAR from the operator account funded in TECH-560
# to the two addresses in accounts.json. The Hedera portal faucet refills that
# operator account with 1000 HBAR a day, which is far more than the demo needs.

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the portals read the opened accounts from. Only needed when running from a
# directory outside the repo — otherwise libs/privy/accounts.json is found on its own.
PRIVY_ACCOUNTS_PATH=

# Only for running libs/privy/test/refusals.test.ts against the company account:
# access tokens for two signed-in directors, comma separated. Without them that half
# of the suite stands down and the refusal is checked by hand in the portal instead.
PRIVY_DIRECTOR_ACCESS_TOKENS=
