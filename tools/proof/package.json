{
  "name": "@receivables-flow/proof",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx src/engine/seed/business.seed.ts && tsx src/engine/seed/investor.seed.ts",
    "dev": "vite --port 6322",
    "prebuild": "tsx src/engine/seed/business.seed.ts && tsx src/engine/seed/investor.seed.ts",
    "build": "vite build",
    "preview": "vite preview --port 6322",
    "seed:business": "tsx src/engine/seed/business.seed.ts",
    "seed:investor": "tsx src/engine/seed/investor.seed.ts",
    "db:apply": "tsx -e \"import('./src/engine/db/connection.ts').then(m => { m.openProofDb(); console.log('applied'); })\"",
    "db:reset": "rm -f journey.db && npm run db:apply",
    "db:export": "tsx src/engine/db/export.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.13",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.0"
  }
}
