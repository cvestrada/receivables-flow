# Every credential this repository needs, in one file.
#
# Copy to `.env` at the repository root and fill in. One Privy app, one Sepolia
# account and one Hedera operator serve every package and all three portals, so a
# value is changed here once rather than in each directory that happens to read it.
# `.env` is never tracked.

# ── Sepolia · the public record ──────────────────────────────────────────────
# Where company profiles and investor approvals live. The same account registers
# names from the contracts package and signs staff decisions made in HQ.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=

# ── Hedera · the receivable token ────────────────────────────────────────────
# The network the receivable is issued and settled on.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# ECDSA private key of the funded operator account.
HEDERA_OPERATOR_KEY=

# The ATS deployment tokens are issued against. Defaults, if unset, to the one the
# ATS web app itself points at on Hedera testnet — verified live via the mirror node.
# Factory  0.0.9213391
ATS_FACTORY_ID=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
# Resolver 0.0.9212226
ATS_RESOLVER_ID=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a

# ── Privy · the two accounts ─────────────────────────────────────────────────
# Nothing in this block reaches a browser — the portals read the opened accounts
# from accounts.json, which holds addresses and identifiers and no secret.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Ironline Freight's company account: the three directors' email addresses, comma
# separated. Provisioning creates them if they do not exist and builds the
# two-of-three approving group over exactly these three — nobody has to sign in
# first or copy an id off the dashboard.
#
# These have to be addresses that can actually receive mail: each director signs in
# at the business portal with the address named here, and Privy emails them a code.
# The demo uses one catch-all domain, prefixed by which side of the deal the person
# is on, so the three that matter here are obvious at a glance.
PRIVY_DIRECTOR_EMAILS=business-anna@galuaselou.resend.app,business-tom@galuaselou.resend.app,business-grace@galuaselou.resend.app

# Woodgrove Capital's fund account. The id registers the authorization key with
# Privy; the private key signs the fund's allocations and never leaves the server.
# The fund signs in at the investor portal as investor-woodgrove@galuaselou.resend.app,
# but its account is owned by this key rather than by whoever is looking at the
# portal — which is the whole difference between the two sides.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_KEY=

# The network both accounts sign for. Hedera testnet is EVM-compatible.
HEDERA_CAIP2=eip155:296

# Reading balances. Any Hedera testnet JSON-RPC endpoint.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Topping the accounts up: send HBAR from the operator account funded in TECH-560
# to the two addresses in accounts.json. The Hedera portal faucet refills that
# operator account with 1000 HBAR a day, which is far more than the demo needs.

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the portals read the opened accounts from. Only needed when running from a
# directory outside the repo — otherwise libs/privy/accounts.json is found on its own.
PRIVY_ACCOUNTS_PATH=

# Only for running libs/privy/test/refusals.test.ts against the company account:
# access tokens for two signed-in directors, comma separated. Without them that half
# of the suite stands down and the refusal is checked by hand in the portal instead.
PRIVY_DIRECTOR_ACCESS_TOKENS=
