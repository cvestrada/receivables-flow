# Every credential this repository needs. Copy to `.env` at the root; never tracked.
#
# Twelve values, all of them required. Anything that had a working default is now a
# constant in the code instead of a variable here — a knob nobody turns is one more
# thing that can be set wrong.

# ── Sepolia · the public record ───────────────────────────────────────────────
# Any Sepolia JSON-RPC endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# secp256k1 key of the platform's own wallet. It owns receivablesflow.eth, and it is
# the only signer allowed to write a business's invoice counts.
SEPOLIA_PLATFORM_WALLET_PRIVATE_KEY=

# ── Hedera · the receivable ───────────────────────────────────────────────────
# Any Hedera testnet JSON-RPC endpoint.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# secp256k1 key of the funded operator wallet (Hedera account 0.0.x, ECDSA). It
# deploys, issues the note, repays on day 60, and signs the fund's side of a resale.
HEDERA_OPERATOR_WALLET_PRIVATE_KEY=

# secp256k1 key of Bridgeline's wallet — the second approved investor, which buys
# half the position on day 20 and signs for it.
HEDERA_BRIDGELINE_WALLET_PRIVATE_KEY=

# secp256k1 key of a wallet nobody approved. It needs one so it can try to buy and be
# refused by the receivable, rather than refused by us for want of a key.
HEDERA_UNAPPROVED_BUYER_WALLET_PRIVATE_KEY=

# The money everything is paid in: mock USDC this repository deploys, mUSDC, with
# Circle's six decimals. The address below is the one already on Hedera testnet —
# it is public, anyone may deposit from it, and there is nothing to protect.
# Deploy your own with `npm run deploy:musdc -w @rf/contracts-hedera-ats`, which
# also deposits the operator the face value and prints the line to paste here.
#
# Circle's own USDC on Hedera testnet is token 0.0.429274,
# 0x0000000000000000000000000000000000068CDA — the value to use on mainnet, and
# useless on testnet, where its faucet gives $20 per address every two hours and a
# $50,000 repayment can never be funded.
HEDERA_MOCK_USDC_TOKEN_ADDRESS=0xf60C8C5191eFfFCF9024Cb2eA27C7583C0c19f1b

# ── Privy · the accounts ──────────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The same app id, exposed to the browser. Left empty, both portals open straight
# onto the dashboard — which is what the e2e run does.
NEXT_PUBLIC_PRIVY_APP_ID=

# Not a wallet key: Privy's own P-256 authorization key, which signs API requests on
# the fund's behalf. Its id registers it with Privy; the key never leaves the server.
PRIVY_FUND_AUTHORIZATION_KEY_ID=
PRIVY_FUND_AUTHORIZATION_KEY=

# Ironline's three directors, comma separated. Two of the three must approve an
# issuance. Each has to receive mail — Privy emails a sign-in code.
PRIVY_BUSINESS_DIRECTOR_EMAILS=biz-anna@galuaselou.resend.app,biz-tom@galuaselou.resend.app,biz-grace@galuaselou.resend.app
