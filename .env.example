# Every credential this repository needs. Copy to `.env` at the root; never tracked.
# Names say network + owner + what kind of value. Blank means you have to fill it in.

# ── Sepolia · the public record ───────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Owns receivablesflow.eth. The only signer allowed to write a business's record.
SEPOLIA_PLATFORM_PRIVATE_KEY=

# ── Hedera · the receivable ───────────────────────────────────────────────────
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_CAIP2_CHAIN_ID=eip155:296

# Funded operator: deploys, issues, repays on day 60, signs the fund's side of a resale.
HEDERA_OPERATOR_PRIVATE_KEY=

# What everything is paid in. No test USDC is deployed yet — until this is set, a
# repayment is divided and shown but no money moves.
HEDERA_USDC_TOKEN_ADDRESS=

# Bridgeline buys half the position on day 20; the unapproved buyer needs a key of
# its own so the receivable can refuse it rather than us refusing for want of a key.
HEDERA_BRIDGELINE_PRIVATE_KEY=
HEDERA_UNAPPROVED_BUYER_PRIVATE_KEY=

# The ATS deployment tokens are issued against — factory 0.0.9213391, resolver 0.0.9212226.
HEDERA_ATS_FACTORY_ADDRESS=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
HEDERA_ATS_RESOLVER_ADDRESS=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a

# The receivable, and the contract both legs of a resale settle inside. Recorded by
# the issue run in contracts/hedera-ats/deployed.json; change to point at a new note.
HEDERA_RECEIVABLE_TOKEN_ADDRESS=0x6871D6F903C3a2977f89c079B87DA9bBb8ed2960
HEDERA_RECEIVABLE_DVP_ADDRESS=0x46900157F8137F4545F8F1237549cafaBAaF7Cb9

# ── Privy · the accounts ──────────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The same id, exposed to the browser. Empty opens both portals without sign-in,
# which is what the e2e run does.
NEXT_PUBLIC_PRIVY_APP_ID=

# Signs Woodgrove's allocations. Server-side only; never reaches a browser.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Ironline's three directors, two of whom must approve. Must be able to receive mail:
# each signs in at the business portal and Privy emails a code.
PRIVY_BUSINESS_DIRECTOR_EMAILS=biz-anna@galuaselou.resend.app,biz-tom@galuaselou.resend.app,biz-grace@galuaselou.resend.app

# ── Optional · every one of these already has a working default ───────────────
# The demo wallets. Default to the addresses in libs/privy/accounts.json.
HEDERA_IRONLINE_WALLET_ADDRESS=
HEDERA_WOODGROVE_WALLET_ADDRESS=
HEDERA_BRIDGELINE_WALLET_ADDRESS=
SEPOLIA_BUSINESS_WALLET_ADDRESS=
SEPOLIA_INVESTOR_WALLET_ADDRESS=

# The names onboarding registers: ironline.business.receivablesflow.eth.
ENS_PLATFORM_BASE_LABEL=receivablesflow
ENS_BUSINESS_SUBNAME_LABEL=ironline
ENS_INVESTOR_SUBNAME_LABEL=woodgrove

# What the fund gets back on day 20 when no live price can be worked out.
DEMO_RESALE_PRICE_USD=24167

# accounts.json's path, only when running from outside the repo.
PRIVY_ACCOUNTS_JSON_PATH=

# Two signed-in directors' access tokens, for libs/privy/test/refusals.test.ts.
PRIVY_BUSINESS_DIRECTOR_ACCESS_TOKENS=

# Run the ENS integration suite against a fork of Sepolia instead of the live network.
ENS_FORK_ENABLED=
ENS_FORK_BLOCK_NUMBER=
ENS_FORK_RPC_URL=
