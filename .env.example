# Every credential this repository needs, in one file.
#
# Copy to `.env` at the repository root and fill in. One Privy app, one Sepolia
# account and one Hedera operator serve every package and all three portals, so a
# value is changed here once rather than in each directory that happens to read it.
# `.env` is never tracked.
#
# Every name says three things: which network it belongs to, whose it is, and what
# kind of value it holds — `HEDERA_WOODGROVE_WALLET_ADDRESS` rather than
# `WOODGROVE_ADDRESS`. Nobody should have to open the code to find out whether a
# variable wants a key, an address or a URL.

# ── Sepolia · the public record ──────────────────────────────────────────────
# Where company profiles and investor approvals live. One account owns the
# platform's ENS name, registers each company's subname, issues the investor
# approval passes, and writes the invoice counts a business is priced against.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The platform's own account. It is the only signer allowed to write to a
# business's page, which is why a company cannot rewrite its own record.
SEPOLIA_PLATFORM_PRIVATE_KEY=

# The names the demo is onboarded under: ironline.business.receivablesflow.eth
# and woodgrove.investor.receivablesflow.eth.
ENS_PLATFORM_BASE_LABEL=receivablesflow
ENS_BUSINESS_SUBNAME_LABEL=ironline
ENS_INVESTOR_SUBNAME_LABEL=woodgrove

# The wallets those two names point at. Onboarding reads them; unset, it falls
# back to the addresses recorded in libs/privy/accounts.json.
SEPOLIA_BUSINESS_WALLET_ADDRESS=
SEPOLIA_INVESTOR_WALLET_ADDRESS=

# ── Hedera · the receivable token ────────────────────────────────────────────
# The network the receivable is issued, transferred and settled on.

HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# The chain both Privy accounts sign for. Hedera testnet is EVM-compatible.
HEDERA_TESTNET_CAIP2_CHAIN_ID=eip155:296

# ECDSA private key of the funded operator account — it deploys, and it signs the
# fund's side of a resale.
HEDERA_OPERATOR_PRIVATE_KEY=

# The account the day-60 repayment is paid from. Falls back to the operator key.
HEDERA_ISSUER_PRIVATE_KEY=

# The ATS deployment tokens are issued against. Defaults, if unset, to the one the
# ATS web app itself points at on Hedera testnet — verified live via the mirror node.
# Factory  0.0.9213391
HEDERA_ATS_FACTORY_ADDRESS=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
# Resolver 0.0.9212226
HEDERA_ATS_RESOLVER_ADDRESS=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a

# The receivable itself, and the contract both legs of a resale settle inside.
# Both are recorded by the issue run in contracts/hedera-ats/deployed.json and read
# back from there; set them only to point at a freshly issued note.
HEDERA_RECEIVABLE_TOKEN_ADDRESS=
HEDERA_RECEIVABLE_DVP_ADDRESS=

# The money everything is paid in. Repayments and resales both move this token.
HEDERA_USDC_TOKEN_ADDRESS=

# ── The parties on Hedera ────────────────────────────────────────────────────
# Who holds what. Each has a code default matching the demo accounts, so these
# only need setting when the demo runs against different wallets.

# The company that sells the invoice and repays it on day 60.
HEDERA_IRONLINE_WALLET_ADDRESS=

# The fund that buys the whole receivable, then sells half of it.
HEDERA_WOODGROVE_WALLET_ADDRESS=

# The second approved investor, which buys that half on day 20 and signs for it.
HEDERA_BRIDGELINE_WALLET_ADDRESS=
HEDERA_BRIDGELINE_PRIVATE_KEY=

# A buyer nobody approved. It needs a key of its own so that it can *try* to buy
# and be turned away by the receivable rather than by us.
HEDERA_UNAPPROVED_BUYER_PRIVATE_KEY=

# ── Privy · the accounts and who may approve ─────────────────────────────────
# Nothing in this block reaches a browser except the app id — the portals read the
# opened accounts from accounts.json, which holds addresses and identifiers and no
# secret.

PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The same app id, exposed to the browser so the portals can offer sign-in. Left
# empty, both portals open straight onto the dashboard, which is what the e2e run
# does.
NEXT_PUBLIC_PRIVY_APP_ID=

# Woodgrove Capital's fund account. The id registers the authorization key with
# Privy; the private key signs the fund's allocations and never leaves the server.
# The fund signs in at the investor portal as investor-woodgrove@galuaselou.resend.app,
# but its account is owned by this key rather than by whoever is looking at the
# portal — which is the whole difference between the two sides.
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Ironline Freight's company account: the three directors' email addresses, comma
# separated. Provisioning creates them if they do not exist and builds the
# two-of-three approving group over exactly these three — nobody has to sign in
# first or copy an id off the dashboard.
#
# These have to be addresses that can actually receive mail: each director signs in
# at the business portal with the address named here, and Privy emails them a code.
# The demo uses one catch-all domain, prefixed by which side of the deal the person
# is on, so the three that matter here are obvious at a glance.
PRIVY_BUSINESS_DIRECTOR_EMAILS=biz-anna@galuaselou.resend.app,biz-tom@galuaselou.resend.app,biz-grace@galuaselou.resend.app

# Topping the accounts up: send HBAR from the operator account funded in TECH-560
# to the two addresses in accounts.json. The Hedera portal faucet refills that
# operator account with 1000 HBAR a day, which is far more than the demo needs.

# ── The demo's own numbers ───────────────────────────────────────────────────
# What the fund gets back on day 20 when no live price can be worked out. The real
# figure is derived from Ironline's record; this is only the unpriced fallback.
DEMO_RESALE_PRICE_USD=24167

# ── Optional · running from elsewhere, and tests ─────────────────────────────
# Where the portals read the opened accounts from. Only needed when running from a
# directory outside the repo — otherwise libs/privy/accounts.json is found on its own.
PRIVY_ACCOUNTS_JSON_PATH=

# Only for running libs/privy/test/refusals.test.ts against the company account:
# access tokens for two signed-in directors, comma separated. Without them that half
# of the suite stands down and the refusal is checked by hand in the portal instead.
PRIVY_BUSINESS_DIRECTOR_ACCESS_TOKENS=

# Run the ENS integration suite against a fork of Sepolia rather than the live
# network: set the flag, and optionally pin the block and the endpoint forked from.
ENS_FORK_ENABLED=
ENS_FORK_BLOCK_NUMBER=
ENS_FORK_RPC_URL=
